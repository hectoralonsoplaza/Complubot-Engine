--- !u!114 &1179499002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1179499000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: English
    Text: '1. Start on the blue arrow and walk straight ahead.

      2. Once you
      hit the red square, turn right!

      3. Go forward one spot, then turn left.

      4.
      Keep going straight until you find the blue robot at the end!'
    Object: {fileID: 0}
  - Language: Spanish
    Text: "1. Empiezas en la flecha azul y avanzas recto por todas las casillas.\n2.
      Cuando llegas a la casilla roja, giras a la derecha.\n3. Avanzas una casilla
      y luego giras a la izquierda.\n4. Despu\xE9s sigues recto hasta llegar al robot
      azul, que es el final"
    Object: {fileID: 0}
