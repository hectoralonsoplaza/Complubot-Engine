  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '1. Start at the purple arrow and go straight. There is a "No Entry" sign,
    so use a bridge to jump over the square!

    2. Once you pass the sign and reach
    the red square, turn right and move to the green square.

    3. On the green
    square, you will find a screwdriver. You must pick it up!

    4. Then, turn
    left and go straight until you find a screw. Pick it up too! (If you don''t have
    the screwdriver and the screw, you can''t fix the robot).

    5. Turn left and
    move to the red square. Then, turn right and go straight until you reach the
    purple robot.

    6. Once you fix the purple robot, you are done!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b7102cbcca5c5b04db151ec962f18746, type: 2}
